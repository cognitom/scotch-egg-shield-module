/*
 * テスト用のキーマップ。config/scotch_egg.keymap と同じ並びを、native_posix_64 で
 * 動かせる形で持つ (windmill の tests/test_keymap.hpp にあたる)。各テストの
 * native_posix_64.keymap から #include "../../windmill.dtsi" で読み、kscan の
 * events だけを足す。
 *
 * 設定レイヤーの &wm_out / &bt / &bootloader / &studio_unlock は native_posix_64 では
 * 使えない (BLE も USB も無い) ので &none にしてある。それ以外は配置を変えたら両方
 * 直すこと。
 *
 * 起動のたびに英数ベースから始まる (windmill の reset_default_layer())。かなで始める
 * テストは、先に TO_KANA で MY_LCTL をタップする。
 *
 * 位置 (行, 列) とキー:
 *   かな    0,1 ぬ  1,4 す  1,7 な  1,9 ら  2,4 は  2,8 の
 *   最下段  3,0 MY_LCTL (タップで言語切替、ホールドで Ctrl + 英数レイヤー)
 *           3,1〜3,8 は &wm_bottom (タップでかな、ホールドで次の役割)
 *           3,1 つ = Win  3,2 さ = Alt  3,3 そ = 左の Fn  3,4 ひ = 左の記号
 *           3,5 こ = 左Shift + Shift 面  3,6 み = 右Shift + Shift 面
 *           3,7 も = 右の記号  3,8 ね = 右の Fn
 *   Shift 面 3,1 っ  3,5 / 3,6 空 (組にならなければ こ / み)  3,7 ？ (半角)  3,8 、
 *   英数    0,1 q  1,1 a  1,10 ;  1,11 '  2,8 ,  2,9 .  3,1 Win  3,2 Alt  3,3 左の Fn
 *           3,4 LT(記号, \)  3,5 左の SandS  3,6 右の SandS  3,7 LT(記号, /)  3,8 右の Fn
 *   Fn      0,0 Esc (透過)  0,1〜0,10 F1〜F10  1,0 Caps Lock  1,1 F11  1,2 F12
 *           3,0 MY_IME (3,3 で Fn を上げたまま叩く。FN_TAP を使う)
 *   設定    1,1 MY_WIN  1,2 MY_ANDR  2,1 MY_JIS  2,2 MY_US
 *           (3,3 で Fn を上げたまま 3,8 を押すと上がる。CONF_TAP を使う)
 */

#include <behaviors.dtsi>
#include <behaviors/windmill.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

&kscan {
    rows = <4>;
    columns = <12>;
};

/* 50ms 押して離し、50ms 置く (windmill のテストの tap_all と同じ叩き方)。1文字の送出は
 * 長くても 100ms ほどなので、続けて叩くと前の文字の送出と重なることがある */
#define TAP(row, col) ZMK_MOCK_PRESS(row, col, 50) ZMK_MOCK_RELEASE(row, col, 50)

/* 時刻を並べて押し離しする (windmill のテストの BottomRow::play())。gap は次のイベント
 * までの ms。ZMK_MOCK_PRESS / RELEASE に書いた待ちは、実際には次のイベントまで 1ms 長く
 * なる (k_work_schedule の相対指定は1ティック余分に待つ) ので、その分を引いておく。
 * 最下段のタップ・ホールドの境界 (150ms / 250ms ちょうど) を ms 単位で固定するため */
#define DN_GAP(row, col, gap) ZMK_MOCK_PRESS(row, col, ((gap) - 1))
#define UP_GAP(row, col, gap) ZMK_MOCK_RELEASE(row, col, ((gap) - 1))

/* 設定レイヤーのキーを叩く (windmill のテストの tap_on_conf と同じく、左右の Fn を
 * 押してから叩き、逆の順で離す) */
#define CONF_TAP(row, col)                                                                         \
    ZMK_MOCK_PRESS(3, 3, 50) ZMK_MOCK_PRESS(3, 8, 50) TAP(row, col) ZMK_MOCK_RELEASE(3, 8, 50)    \
        ZMK_MOCK_RELEASE(3, 3, 50)

/* Fn レイヤーのキーを叩く (windmill のテストの tap_with_fn と同じく、左の Fn を押して
 * から叩いて離す) */
#define FN_TAP(row, col) ZMK_MOCK_PRESS(3, 3, 250) TAP(row, col) ZMK_MOCK_RELEASE(3, 3, 120)

/* 起動直後の英数から、MY_LCTL のタップでかなへ移る */
#define TO_KANA TAP(3, 0)

/ {
    keymap {
        compatible = "zmk,keymap";

        kana_layer {
            bindings = <
&kp ESC                 &wm_char KN_NU   &wm_char KN_FU   &wm_char KN_A    &wm_char KN_U    &wm_char KN_E    &wm_char KN_O    &wm_char KN_YA   &wm_char KN_YU   &wm_char KN_YO   &wm_char KN_WA   &kp RET
&kp TAB                 &wm_char KN_TA   &wm_char KN_TE   &wm_char KN_I    &wm_char KN_SU   &wm_char KN_KA   &wm_char KN_N    &wm_char KN_NA   &wm_char KN_NI   &wm_char KN_RA   &wm_char KN_SE   &wm_char KN_DAKU
&kp BSPC                &wm_char KN_CHI  &wm_char KN_TO   &wm_char KN_SHI  &wm_char KN_HA   &wm_char KN_KI   &wm_char KN_KU   &wm_char KN_MA   &wm_char KN_NO   &wm_char KN_RI   &wm_char KN_RE   &wm_char KN_KE
&wm_lctl LCTRL MY_LANG  &wm_bottom KB_TSU  &wm_bottom KB_SA  &wm_bottom KB_SO  &wm_bottom KB_HI  &wm_bottom KB_KO  &wm_bottom KB_MI  &wm_bottom KB_MO  &wm_bottom KB_NE  &wm_char KN_RU  &wm_char KN_ME  &wm_char KN_RO
            >;
        };

        kana_shift_layer {
            bindings = <
&trans  &trans              &trans          &wm_char KN_XA   &wm_char KN_XU   &wm_char KN_XE      &wm_char KN_XO      &wm_char KN_XYA     &wm_char KN_XYU       &wm_char KN_XYO     &wm_char KN_WO        &trans
&trans  &trans              &wm_char KN_HE  &wm_char KN_XI   &wm_char KN_MU   &trans              &trans              &wm_char KN_HO      &trans                &wm_char KN_LKAKKO  &wm_char KN_RKAKKO    &wm_char KN_HANDAKU
&trans  &wm_char KN_XTSU    &trans          &trans           &trans           &trans              &trans              &trans              &wm_char KN_TOUTEN    &wm_char KN_KUTEN   &wm_char KN_NAKAGURO  &wm_char KN_CHOON
&trans  &wm_bottom KB_XTSU  &trans          &trans           &trans           &wm_bottom KB_SPC   &wm_bottom KB_SPC   &wm_bottom KB_QUES  &wm_bottom KB_TOUTEN  &wm_char KN_KUTEN   &wm_char KN_NAKAGURO  &trans
            >;
        };

        alpha_layer {
            bindings = <
&trans  &kp Q         &kp W         &kp E           &kp R                  &kp T                  &kp Y                  &kp U                  &kp I           &kp O      &kp P            &trans
&trans  &kp A         &kp S         &kp D           &kp F                  &kp G                  &kp H                  &kp J                  &kp K           &kp L      &wm_alpha SEMI   &wm_alpha SQT
&trans  &kp Z         &kp X         &kp C           &kp V                  &kp B                  &kp N                  &kp M                  &kp COMMA       &wm_alpha DOT  &kp UP       &kp RIGHT
&trans  &wm_mod LGUI  &wm_mod LALT  &wm_mo WM_FN_L  &wm_lt LAYER_SYM BSLH  &wm_sands LSHFT SPACE  &wm_sands RSHFT SPACE  &wm_lt LAYER_SYM FSLH  &wm_mo WM_FN_R  &kp K_APP  &kp LEFT         &kp DOWN
            >;
        };

        sym_layer {
            bindings = <
&trans  &wm_char SY_1     &wm_char SY_2     &wm_char SY_3     &wm_char SY_4     &wm_char SY_5     &wm_char SY_6     &wm_char SY_7     &wm_char SY_8     &wm_char SY_9     &wm_char SY_0     &trans
&trans  &wm_char SY_EXLM  &wm_char SY_AT    &wm_char SY_HASH  &wm_char SY_DLR   &wm_char SY_PERC  &wm_char SY_CIRC  &wm_char SY_AMPR  &wm_char SY_ASTR  &wm_char SY_LPRN  &wm_char SY_RPRN  &wm_char SY_GRV
&trans  &wm_char SY_EQL   &wm_char SY_PLUS  &wm_char SY_MINS  &wm_char SY_UNDS  &wm_char SY_LBRC  &wm_char SY_RBRC  &wm_char SY_TILD  &wm_char SY_LCBR  &wm_char SY_RCBR  &kp UP            &kp RIGHT
&trans  &trans            &trans            &trans            &trans            &wm_char SY_PIPE  &wm_char SY_QUES  &trans            &trans            &trans            &kp LEFT          &kp DOWN
            >;
        };

        fn_layer {
            bindings = <
&trans           &kp F1     &kp F2   &kp F3          &kp F4   &kp F5        &kp F6        &kp F7      &kp F8          &kp F9        &kp F10    &none
&kp CAPS         &kp F11    &kp F12  &none           &none    &none         &none         &none       &none           &none         &none      &none
&kp DEL          &kp PSCRN  &none    &none           &none    &kp C_BRI_DN  &kp C_BRI_UP  &kp C_MUTE  &kp C_VOL_DN    &kp C_VOL_UP  &kp UP     &kp RIGHT
&wm_lang MY_IME  &trans     &trans   &trans          &trans   &trans        &trans        &trans      &trans          &trans        &kp LEFT   &kp DOWN
            >;
        };

        conf_layer {
            bindings = <
&none  &none            &none             &none   &none  &none  &none  &none  &none   &none  &none  &none
&none  &wm_host MY_WIN  &wm_host MY_ANDR  &none   &none  &none  &none  &none  &none   &none  &none  &none
&none  &wm_host MY_JIS  &wm_host MY_US    &none   &none  &none  &none  &none  &none   &none  &none  &none
&none  &none            &none             &trans  &none  &none  &none  &none  &trans  &none  &none  &none
            >;
        };
    };
};
