/*
 * windmill の behavior の定義。キーマップから
 * `#include <behaviors/windmill.dtsi>` で読み込む
 */

#include <dt-bindings/windmill/host.h>
#include <dt-bindings/windmill/keys.h>
#include <dt-bindings/windmill/layers.h>

/ {
    behaviors {
        /* 参照しないキーマップでは Kconfig ごと無効にしたいので、未参照なら消す */
        /omit-if-no-ref/ wm_char: wm_char {
            compatible = "zmk,behavior-wm-char";
            #binding-cells = <1>;
            display-name = "Windmill Char";
        };

        /omit-if-no-ref/ wm_host: wm_host {
            compatible = "zmk,behavior-wm-host";
            #binding-cells = <1>;
            display-name = "Windmill Host";
        };
    };
};
