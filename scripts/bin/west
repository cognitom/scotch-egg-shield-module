#!/bin/sh
# compose.agent.yaml の zmk サービスへ `west` を振り向けるラッパー。コマンドをコンテナへ
# 振り向ける仕組み (shim) が無い環境 (CI や手元) で、このディレクトリを PATH に足して使う。
# 先に `docker compose -f compose.agent.yaml up -d --wait` で zmk サービスを立てておく
compose="$(dirname "$0")/../../compose.agent.yaml"

# exec はホストの環境変数を持ち込まないので、テストの出し方を変えるものだけ渡す
# (ZMK の run-test.sh が読む。CI ではビルドの失敗を見えるよう ZMK_TESTS_VERBOSE を立てる)
set --  ${ZMK_TESTS_VERBOSE:+-e ZMK_TESTS_VERBOSE="$ZMK_TESTS_VERBOSE"} \
        ${ZMK_TESTS_AUTO_ACCEPT:+-e ZMK_TESTS_AUTO_ACCEPT="$ZMK_TESTS_AUTO_ACCEPT"} \
        zmk west "$@"

# tty は stdin と stdout の両方が端末のときだけ取る。パイプ越しに取ると出力に CR が混ざる
if [ -t 0 ] && [ -t 1 ]; then
  exec docker compose -f "$compose" exec "$@"
fi
exec docker compose -f "$compose" exec -T "$@"
